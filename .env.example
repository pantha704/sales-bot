# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TTS_VOICE=troy

NEUPHONIC_API_KEY=
NEUPHONIC_VOICE_ID=

# browser (free Web Speech API, default) | neuphonic (optional cloud) | groq (paid Orpheus)
TTS_PROVIDER=browser
# Optional: set to 1 only if you want the client to call /api/roleplay/speech
# NEXT_PUBLIC_CLOUD_TTS=

# Production webhook from the exported n8n workflow.
# If N8N_LEAD_WEBHOOK_URL is set, N8N_WEBHOOK_SECRET is required (fail closed).
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional but recommended in production: serverless-safe rate limiting.
# Create a free Redis DB at https://console.upstash.com and paste REST creds.
# When unset, the app uses process-local memory limits (not multi-instance safe).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
