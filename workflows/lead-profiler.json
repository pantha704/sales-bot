      "parameters": {
        "jsCode": "const incoming = $input.first().json;\nconst body = incoming.body ?? incoming;\nconst required = ['leadId', 'submittedAt', 'name', 'email', 'company', 'query', 'pageHistory'];\nconst missing = required.filter((field) => body[field] === undefined || body[field] === null || body[field] === '');\n\nif (missing.length) {\n  throw new Error(`Missing required fields: ${missing.join(', ')}`);\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(body.email))) {\n  throw new Error('Email address is invalid.');\n}\n\nif (!Array.isArray(body.pageHistory) || body.pageHistory.length === 0 || body.pageHistory.length > 10) {\n  throw new Error('pageHistory must contain between 1 and 10 page paths.');\n}\n\nconst clean = (value, max) => String(value ?? '').trim().slice(0, max);\n\nreturn [{\n  json: {\n    leadId: clean(body.leadId, 80),\n    submittedAt: clean(body.submittedAt, 40),\n    source: clean(body.source || 'website-form', 80),\n    name: clean(body.name, 80),\n    email: clean(body.email, 160).toLowerCase(),\n    company: clean(body.company, 100),\n    jobTitle: clean(body.jobTitle, 100),\n    query: clean(body.query, 1000),\n    pageHistory: body.pageHistory.map((page) => clean(page, 160)),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        0
      ],
      "id": "5ce35ca4-9933-4c88-8796-b0f8fab4dd2c",
