      "name": "Groq Lead Classifier",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_GROQ_HEADER_CREDENTIAL",
          "name": "Groq API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Validate & Normalize').first().json;\nconst raw = $input.first().json?.choices?.[0]?.message?.content;\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  throw new Error('The classifier returned no content.');\n}\n\nlet profile;\ntry {\n  profile = JSON.parse(raw);\n} catch {\n  throw new Error('The classifier returned malformed JSON.');\n}\n\nconst allowed = ['Organizational Development', 'Sales Bots'];\nif (!allowed.includes(profile.category)) {\n  throw new Error('The classifier returned an unsupported category.');\n}\n\nconst reason = String(profile.reason ?? '').trim();\nif (reason.length < 5 || reason.length > 500) {\n  throw new Error('The classifier reason is missing or too long.');\n}\n\nreturn [{ json: { ...source, category: profile.category, reason } }];"
      },
